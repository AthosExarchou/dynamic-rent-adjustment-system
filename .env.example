# =============================================================================
# DRAS - Production Environment Variables
# =============================================================================
# Copy this file to .env on the Oracle VM and fill in the real values:
#
#   cp .env.example .env
#   nano .env
#
# NEVER commit .env to Git - it is excluded by .gitignore
# =============================================================================


# PostgreSQL
# The database name, user, and password used by both the db and backend
# containers. Docker Compose reads these at startup.
DATABASE_NAME=dras_db
DATABASE_USERNAME=dras

# Generate a strong password with:
#   openssl rand -base64 32
DATABASE_PASSWORD=change-me


# Email (Gmail SMTP)
# Used by Spring Boot to send system notifications (rental approvals etc.)
MAIL_USERNAME=your-address@gmail.com

# Use a Gmail App Password, NOT your account password.
# Enable 2-Step Verification, then generate one at:
#   https://myaccount.google.com/apppasswords
MAIL_PASSWORD=change-me
